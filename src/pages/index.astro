---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import headshot from '../assets/headshot.jpg';

const githubUrl = 'https://github.com/jordonKloiber';
const linkedinUrl = 'https://www.linkedin.com/in/jordon-kloiber';

const title = 'Jordon Kloiber | Senior QA Engineer / SDET';
const description =
  'Jordon Kloiber is a Senior QA Engineer and SDET in Pittsburgh, PA, focused on test automation and quality strategy for web, iOS, and Android products.';

// Mirrors the Technical skills section of the resume.
const tools = [
  ['Languages & frameworks', 'TypeScript, JavaScript, Python, Java, SQL, Go, React.js, Astro'],
  [
    'Methodologies',
    'Agile, Scrum, Shift-Left Testing, Risk-Based Testing, Continuous Testing',
  ],
  [
    'Test frameworks',
    'Playwright, Nightwatch, Cucumber (Gherkin), Jest, PyTest, Storybook, API Proctor (in-house API test framework), Postman, Swagger, axe-core',
  ],
  ['API testing', 'REST API, Postman, Swagger, API Proctor (in-house API test framework)'],
  ['CI/CD & infrastructure', 'GitHub Actions, Docker, Git, GitHub, GitHub Pages, Kubernetes'],
  ['Mobile testing', 'Appium, Maestro, iOS, Android, BrowserStack'],
  ['Performance testing', 'k6'],
  ['Security testing', 'OWASP Top 10, Snyk'],
  ['Databases & data tools', 'PostgreSQL, MySQL, Redis, DBeaver, AWS (RDS)'],
  ['AI tools', 'Claude Code, Claude Skills, GitHub Copilot'],
  [
    'Debugging & bug tracking',
    'Browser DevTools, Network Profiling, Jira, Confluence, Google Analytics, SumoLogic, Snowflake',
  ],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://jordonkloiber.com/#person',
  name: 'Jordon Kloiber',
  url: 'https://jordonkloiber.com',
  image: 'https://jordonkloiber.com/headshot.jpg',
  jobTitle: 'Senior QA Engineer / SDET',
  description: 'Senior QA Engineer and SDET in Pittsburgh, Pennsylvania.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Pittsburgh',
    addressRegion: 'PA',
    addressCountry: 'US',
  },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Pittsburgh' },
  knowsAbout: [
    'Test Automation',
    'Playwright',
    'API Testing',
    'Web Accessibility',
    'WCAG',
    'CI/CD',
    'A/B Testing',
    'TypeScript',
  ],
  sameAs: [linkedinUrl, githubUrl],
};
---

<Base title={title} description={description} ogType="profile" jsonLd={jsonLd}>
  <Picture
    class="avatar"
    src={headshot}
    formats={['avif', 'webp']}
    widths={[88, 176]}
    sizes="88px"
    width={88}
    height={88}
    alt="Jordon Kloiber"
    loading="eager"
    fetchpriority="high"
  />

  <h1 class="name">Jordon Kloiber</h1>
  <p class="meta">Senior QA Engineer / SDET</p>
  <p class="meta">Pittsburgh, Pennsylvania</p>
  <p class="meta availability"><strong>Currently open to new roles</strong></p>

  <section class="section">
    <h2>About</h2>
    <p>Hi I'm Jordon,</p>
    <p>
      I have always been interested in software, but I fell into QA during
      my summer internship in 2016. QA work was the majority of what
      they needed from me, so I jumped in. It didn't take long to realize I
      thoroughly enjoyed the puzzle of it. Finding the one thing everyone
      missed, whether by hand or by writing the automation that catches it,
      is always rewarding.
    </p>
    <p>
      What draws me in is working across the whole stack. I like
      understanding how the frontend, APIs, database, and CI pipeline all
      fit together, and I'm always picking up the next piece. That doesn't
      mean I can't go deep when a role calls for it, just that I'd rather
      not be boxed into one layer. Right now that means learning test
      strategy for AI features and emerging new structures like
      microfrontends and module federation. I use tools like Claude Code and
      agents to move faster, but I think through each problem
      myself, so I'd rather catch something in a design review or a PR than
      chase a coverage number later.
    </p>
    <p>
      Outside of work I train Brazilian Jiu-Jitsu three or four times a
      week, hike Pittsburgh's many green spaces (plus trips into the rest
      of PA and WV), and try to travel abroad once a year. Otherwise, I've
      probably got a fantasy or sci-fi novel open.
    </p>
  </section>

  <section class="section">
    <h2>What people say</h2>
    <ul class="rows">
      <li>
        <p class="row-desc">
          <em>
            "Jordon consistently holds an exceptionally high bar for
            quality, demonstrating a remarkable ability to identify bugs,
            uncover obscure edge cases, understand root causes, and work
            collaboratively to drive issues toward resolution."
          </em>
        </p>
        <span class="row-label">Noble Lee</span>{' '}
        <span class="row-desc">Director of Engineering at Niche</span>{' '}
        <a class="icon-link" href={linkedinUrl} aria-label="View recommendation on LinkedIn">
          <Icon name="linkedin" />
        </a>
      </li>
      <li>
        <p class="row-desc">
          <em>
            "You would be hard-pressed to find anyone in any role who is
            more hard-working, thoughtful, and thorough than Jordon. His
            attention to detail caught many bugs other QAEs would have
            missed."
          </em>
        </p>
        <span class="row-label">Keith Murgic</span>{' '}
        <span class="row-desc">Senior Full-Stack Software Engineer</span>{' '}
        <a class="icon-link" href={linkedinUrl} aria-label="View recommendation on LinkedIn">
          <Icon name="linkedin" />
        </a>
      </li>
    </ul>
  </section>

  <section class="section">
    <h2>What I work with</h2>
    <ul class="rows">
      {
        tools.map(([label, desc]) => (
          <li>
            <span class="row-label">{label}</span>{' '}
            <span class="row-desc">{desc}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>Work</h2>
    <ul class="rows">
      <li>
        <a href="/work/"><span class="row-label">Case studies</span></a>
      </li>
      <li>
        <a href="/resume"><span class="row-label">Resume</span></a>{' '}
        <span class="row-desc">Full work history, with a PDF download</span>
      </li>
    </ul>
  </section>

  <section class="section">
    <h2>Elsewhere</h2>
    <ul class="rows">
      <li>
        <a href={githubUrl}><Icon name="github" /><span class="row-label">GitHub</span></a>{' '}
        <span class="row-desc">Source for this site</span>
      </li>
      <li>
        <a href={linkedinUrl}><Icon name="linkedin" /><span class="row-label">LinkedIn</span></a>{' '}
        <span class="row-desc">Work history</span>
      </li>
    </ul>
  </section>

  <section class="section">
    <h2>Contact</h2>
    <p>
      <a class="nav-link" href="mailto:jordonk267+site@gmail.com">jordonk267+site@gmail.com</a>
    </p>
  </section>
</Base>
