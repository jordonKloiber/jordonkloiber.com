---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import headshot from '../assets/headshot.jpg';

const githubUrl = 'https://github.com/jordonKloiber';
const linkedinUrl = 'https://www.linkedin.com/in/jordon-kloiber';

const title = 'Jordon Kloiber | Senior QA Engineer / SDET';
const description =
  'Jordon Kloiber is a Senior QA Engineer and SDET in Pittsburgh, PA, focused on test automation and quality strategy for web, iOS, and Android products.';

// Verbatim from the Technical skills section of the resume.
const tools = [
  ['Languages & frameworks', 'TypeScript, JavaScript, Python, Java, SQL, Go, React.js'],
  [
    'Test frameworks',
    'Playwright, Jest, PyTest, Storybook, API Proctor (in-house API test framework), Postman, Swagger, Nightwatch',
  ],
  ['Mobile testing', 'Appium, Maestro, iOS, Android, BrowserStack'],
  ['CI/CD & infrastructure', 'GitHub Actions, Docker, Git, GitHub, Kubernetes'],
  ['Databases & data tools', 'PostgreSQL, MySQL, Redis, DBeaver, AWS (RDS)'],
  ['AI tools', 'Claude Code, Claude Skills, GitHub Copilot'],
  [
    'Debugging & bug tracking',
    'Browser DevTools, Network Profiling, Jira, Confluence, Google Analytics, SumoLogic, Snowflake, Snyk',
  ],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://jordonkloiber.com/#person',
  name: 'Jordon Kloiber',
  url: 'https://jordonkloiber.com',
  image: 'https://jordonkloiber.com/headshot.jpg',
  jobTitle: 'Senior QA Engineer / SDET',
  description: 'Senior QA Engineer and SDET in Pittsburgh, Pennsylvania.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Pittsburgh',
    addressRegion: 'PA',
    addressCountry: 'US',
  },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Pittsburgh' },
  knowsAbout: [
    'Test Automation',
    'Playwright',
    'API Testing',
    'Web Accessibility',
    'WCAG',
    'CI/CD',
    'A/B Testing',
    'TypeScript',
  ],
  sameAs: [linkedinUrl, githubUrl],
};
---

<Base title={title} description={description} ogType="profile" jsonLd={jsonLd}>
  <Picture
    class="avatar"
    src={headshot}
    formats={['avif', 'webp']}
    widths={[88, 176]}
    sizes="88px"
    width={88}
    height={88}
    alt="Jordon Kloiber"
    loading="eager"
    fetchpriority="high"
  />

  <h1 class="name">Jordon Kloiber</h1>
  <p class="meta">Senior QA Engineer / SDET</p>
  <p class="meta">Pittsburgh, Pennsylvania</p>
  <p class="meta availability">Currently open to new roles.</p>

  <section class="section">
    <h2>About</h2>
    <p>
      I'm a Senior QA Engineer and SDET with 5+ years building test automation
      and quality strategy from the ground up, most recently owning quality
      end-to-end for a high-traffic registration product: test strategy, CI/CD
      health, and full-stack automation across web, iOS, and Android.
    </p>
    <p>
      I use AI coding tools like Claude Code and GitHub Copilot as a force
      multiplier, not a shortcut, and favor a risk-based, shift-left approach:
      catching problems in a design review or a pull request before they reach
      users. Coverage numbers matter less to me than real-world impact and
      accessibility.
    </p>
  </section>

  <section class="section">
    <h2>What I work with</h2>
    <ul class="rows">
      {
        tools.map(([label, desc]) => (
          <li>
            <span class="row-label">{label}</span>{' '}
            <span class="row-desc">{desc}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>Work</h2>
    <ul class="rows">
      <li>
        <a href="/work/"><span class="row-label">Case studies</span></a>{' '}
        <span class="row-desc">In progress</span>
      </li>
      <li>
        <a href="/resume"><span class="row-label">Resume</span></a>{' '}
        <span class="row-desc">Full work history, with a PDF download</span>
      </li>
    </ul>
  </section>

  <section class="section">
    <h2>Elsewhere</h2>
    <ul class="rows">
      <li>
        <a href={githubUrl}><Icon name="github" /><span class="row-label">GitHub</span></a>{' '}
        <span class="row-desc">Source for this site</span>
      </li>
      <li>
        <a href={linkedinUrl}><Icon name="linkedin" /><span class="row-label">LinkedIn</span></a>{' '}
        <span class="row-desc">Work history</span>
      </li>
    </ul>
  </section>

  <section class="section">
    <h2>Contact</h2>
    <p>
      <a href="mailto:jordonk267+site@gmail.com">jordonk267+site@gmail.com</a>
    </p>
  </section>
</Base>
