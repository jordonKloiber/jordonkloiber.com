---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Jordon Kloiber | Work"
  description="Case studies from Jordon Kloiber, a Senior QA Engineer and SDET in Pittsburgh, PA, covering test strategy, automation, and quality engineering work in detail."
>
  <p><a href="/">&larr; Back to home</a></p>
  <h1>Work</h1>
  {
    entries.length === 0 ? (
      <p>
        Case studies are in progress. In the meantime, see the{' '}
        <a href="/resume">resume</a> for a full history.
      </p>
    ) : (
      <ul>
        {entries.map((entry) => (
          <li>
            <a href={`/work/${entry.id}/`}>{entry.data.title}</a>
            <p>{entry.data.summary}</p>
          </li>
        ))}
      </ul>
    )
  }
</Base>
